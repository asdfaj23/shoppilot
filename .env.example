# 复制为 .env 后填写；所有变量均可通过环境变量覆盖（pydantic-settings）。

# ===== LLM 提供方（OpenAI 兼容协议，DeepSeek / 硅基流动 / vLLM / Ollama 均可）=====
SHOPPILOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPPILOT_BASE_URL=https://api.deepseek.com/v1
SHOPPILOT_MODEL=deepseek-chat

# 本地 Ollama（OpenAI 兼容端点）示例：
# SHOPPILOT_BASE_URL=http://localhost:11434/v1
# SHOPPILOT_MODEL=qwen2.5:7b
# SHOPPILOT_API_KEY=ollama

# ===== 运行参数（可选，默认值见 src/shoppilot/core/settings.py）=====
# SHOPPILOT_MAX_STEPS=6
# SHOPPILOT_PRICE_PER_M_TOKENS=2.0
# SHOPPILOT_DATA_DIR=./data
